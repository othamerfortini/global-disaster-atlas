{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-disaster-atlas.org/schemas/canonical-event.json",
  "title": "Global Disaster Atlas Canonical Event",
  "type": "object",
  "required": ["event_id", "name", "hazard", "time", "location", "sources"],
  "properties": {
    "event_id": {"type": "string"},
    "name": {"type": "string"},
    "hazard": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "subtype": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "required": ["start", "precision"],
      "properties": {
        "start": {"type": ["string", "null"], "format": "date-time"},
        "end": {"type": ["string", "null"], "format": "date-time"},
        "precision": {"enum": ["exact", "day", "month", "year", "decade", "century", "approximate", "unknown"]}
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "country": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "physical": {"type": "object"},
    "impact": {
      "type": "object",
      "properties": {
        "deaths": {"$ref": "#/$defs/range"},
        "injured": {"$ref": "#/$defs/range"},
        "missing": {"$ref": "#/$defs/range"},
        "affected": {"$ref": "#/$defs/range"},
        "displaced": {"$ref": "#/$defs/range"},
        "economic_loss": {"$ref": "#/$defs/economicLoss"}
      },
      "additionalProperties": true
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"},
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target_event_id"],
        "properties": {
          "type": {"enum": ["triggered_by", "triggered", "followed_by", "caused", "contributed_to", "related_to", "aftershock_of", "part_of", "compound_with"]},
          "target_event_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "properties": {
        "min": {"type": ["integer", "null"], "minimum": 0},
        "max": {"type": ["integer", "null"], "minimum": 0},
        "reported": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["reported", "estimated", "modeled", "unknown"]}
      },
      "additionalProperties": false
    },
    "economicLoss": {
      "type": "object",
      "properties": {
        "amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"]},
        "year": {"type": ["integer", "null"]},
        "status": {"enum": ["reported", "estimated", "modeled", "unknown"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "source_event_id": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "license": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
